PORT=5001
NODE_ENV=development

# PostgreSQL + PostGIS Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resq_ai
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=resq_ai

# JWT Security
JWT_SECRET=resq_ai_super_secret_jwt_encryption_key_2026_secure
JWT_EXPIRES_IN=7d

# Hugging Face Inference API (Model: facebook/bart-large-mnli)
HUGGINGFACE_API_KEY=hf_your_huggingface_api_token_here

# Open-Meteo Weather API
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# OSRM Public Routing API
OSRM_BASE_URL=https://router.project-osrm.org

# Firebase Cloud Messaging (FCM) Credentials (JSON string or path)
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=

# Client Origin (CORS & Socket.io)
CLIENT_ORIGIN=http://localhost:5173
