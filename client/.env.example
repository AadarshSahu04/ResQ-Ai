# RESQ-AI Client Environment Configuration
# Backend API URL (leave blank for local development to use Vite proxy)
# For production (e.g. Vercel): set to your Render backend URL, e.g. https://resq-ai-backend.onrender.com
VITE_API_URL=

# Real-Time WebSocket URL (defaults to VITE_API_URL if unset)
VITE_SOCKET_URL=
